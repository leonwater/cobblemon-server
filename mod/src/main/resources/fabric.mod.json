{
  "schemaVersion": 1,
  "id": "pokeserver",
  "version": "${version}",
  "name": "잡켓몬 서버",
  "description": "pokeserver 전용: 농장 땅, 상점, 메인 메뉴, 닉네임",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pokeserver.PokeServer"
    ],
    "client": [
      "com.pokeserver.client.PokeServerClient"
    ]
  },
  "accessWidener": "pokeserver.accesswidener",
  "suggests": {
    "cobblemon": "*"
  },
  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "pokeserver_assets": "*"
  },
  "mixins": [
    "pokeserver.mixins.json",
    { "config": "pokeserver.client.mixins.json", "environment": "client" }
  ]
}
